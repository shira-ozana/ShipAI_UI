# Optional. Leave empty to call the relative /api/chat URL, which the Vite dev server
# proxies to http://127.0.0.1:8000. When set, the browser calls this origin directly
# (e.g. http://127.0.0.1:8000) and the backend must allow CORS for the UI's origin.
VITE_API_URL=

# Optional. Set to "true" to use the built-in mock instead of the real backend.
# The mock is never used as a fallback after an API error.
VITE_USE_MOCK=
