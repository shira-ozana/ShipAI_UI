# Optional. Leave empty to call the relative /api/chat URL, which the Vite dev server
# proxies to http://127.0.0.1:8000. When set, the browser calls this origin directly
# (e.g. http://127.0.0.1:8000) and the backend must allow CORS for the UI's origin.
VITE_API_URL=

# Optional. Set to "true" to use the built-in mock instead of the real backend.
# The mock is never used as a fallback after an API error.
VITE_USE_MOCK=

# Optional. Base URL of the platform backend that serves /api/users and /api/repositories.
# Leave empty in development: the Vite dev server proxies those paths to http://127.0.0.1:8000.
# That backend allows CORS only for http://localhost:4200, so a direct call from the UI fails.
VITE_PLATFORM_API_URL=

# Optional. Base URL of the Generic Agent API that serves /api/init (and /api/chat).
# Defaults to VITE_API_URL. Empty uses the relative /api/init path, which the Vite dev server
# proxies to http://127.0.0.1:3000.
VITE_AGENT_API_URL=
